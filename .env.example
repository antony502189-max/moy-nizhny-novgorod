# Default static release: leave these values empty.
# Set the client endpoint at build time only for a deployment with an online AI option.
VITE_TOUR_API=
VITE_VOICE_API=
# Server only. Origins may be comma separated for a separately hosted static site.
DEEPSEEK_API_KEY=
PUBLIC_APP_ORIGINS=
# Optional server-side settings for api/tour.ts on the same origin.
TOUR_API_ENABLED=
TOUR_MODEL=
ANTHROPIC_API_KEY=
# Alternative OpenAI-compatible provider
LLM_BASE_URL=
LLM_API_KEY=
# Shared request budget for online mode (5/minute, 100/day for the deployment)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
