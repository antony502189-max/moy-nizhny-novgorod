{
  "name": "nizhny-for-guests",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/package-site.mjs",
    "preview": "vite preview",
    "data:amenities": "node scripts/fetch-amenities.mjs",
    "test": "node --experimental-strip-types --test resident/domain/*.test.ts tests/*.test.mjs",
    "pages:prepare": "npm run build && node scripts/package-site.mjs --pages",
    "test:browser": "node --experimental-strip-types scripts/check-browser.mjs"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "leaflet.heat": "^0.2.0",
    "leaflet.markercluster": "^1.5.3",
    "lucide-react": "0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.12",
    "@types/leaflet.markercluster": "^1.5.6",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "playwright-core": "1.62.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.0"
  }
}
